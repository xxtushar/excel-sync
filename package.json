  "description": "Keeps the avyra MySQL database in sync with an Excel workbook, plus a REST API to maintain it.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "sync": "node scripts/sync-file.js",
    "test": "node --test --test-concurrency=1 test/sync.test.js test/api.test.js",
    "load-dump": "node scripts/load-dump.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "chokidar": "^4.0.3",
    "dotenv": "^18.0.5",
