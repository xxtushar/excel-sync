# --- Database (the avyra MySQL database restored from tusharDump.sql) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=avyra

# --- API ---
PORT=4000
# When set, every request needs the header  x-api-key: <value>
API_KEY=

# --- Auto-sync: watch this workbook and sync a moment after every save ---
# Windows example: WATCH_FILE=C:\Users\tushar\Documents\avyra.xlsx
WATCH_FILE=
WATCH_DEBOUNCE_MS=2000
# Use polling for network drives, WSL or Docker volumes where file events don't arrive
WATCH_POLL=false

# --- Sync rules ---
# Rows removed from a dy_ sheet:
#   soft = set is_active/rstatus/active to 0 where the table has one, otherwise keep the row and warn
#   hard = like soft, but tables without a soft-delete column get a real DELETE (cascades!)
#   none = never delete, only report
DELETE_MODE=soft
SOFT_DELETE_COLUMNS=is_active,rstatus,active
# Rows with an empty id: reject (tells you which id to use) or insert (AUTO_INCREMENT; you must copy the id back)
BLANK_ID_MODE=reject
# Columns in a sheet that are not in the table: warn (ignore them) or error
UNKNOWN_COLUMN_MODE=warn
IGNORE_SHEETS=_README
STATIC_PREFIX=st_
DYNAMIC_PREFIX=dy_

MAX_UPLOAD_MB=20
PAGE_LIMIT_MAX=500

# --- Tests only: throwaway database rebuilt from test/fixtures/tusharDump.sql ---
TEST_DB_NAME=avyra_test
