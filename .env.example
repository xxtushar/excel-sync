# Prefer config.json (copy config.example.json): same settings, with real lists and numbers.
# This file still works; where both set a value, config.json wins, and a variable set in the shell beats both.
# Every setting is optional; these are the defaults.

# Database the admin upload API uses (check-upload never connects to it)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=avyra

# Standalone API server (npm start)
PORT=4000
API_KEY=
MAX_UPLOAD_MB=20
PREVIEW_MINUTES=15

# Columns that mark a row as switched off (0), first match wins
SOFT_DELETE_COLUMNS=is_active,rstatus,active
IGNORE_SHEETS=_README
STATIC_PREFIX=st_
DYNAMIC_PREFIX=dy_
